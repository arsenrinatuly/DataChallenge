# Скопируйте в .env и заполните. Без ключа система работает в офлайн-режиме (правила).

# --- Вариант 1: Anthropic Claude
# CQA_LLM_PROVIDER=anthropic
# CQA_LLM_API_KEY=sk-ant-...
# CQA_LLM_MODEL=claude-sonnet-5-5
# CQA_LLM_EFFORT=medium        # low | medium | high — глубина рассуждений Claude
# CQA_PRICE_IN_PER_M=2
# CQA_PRICE_OUT_PER_M=10

# --- Вариант 2: OpenAI или любой OpenAI-совместимый API (Groq, OpenRouter, Gemini)
# CQA_LLM_PROVIDER=openai
# CQA_LLM_API_KEY=sk-...
# CQA_LLM_MODEL=gpt-4o-mini
# CQA_LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:  CQA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    CQA_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Вариант 3: локальная модель через Ollama (бесплатно, без ключа)
# CQA_LLM_PROVIDER=openai
# CQA_LLM_BASE_URL=http://localhost:11434/v1
# CQA_LLM_MODEL=qwen2.5:14b

# Цена модели за 1M токенов (USD) — для расчёта стоимости одной оценки. Возьмите с прайс-страницы провайдера.
# CQA_PRICE_IN_PER_M=0
# CQA_PRICE_OUT_PER_M=0

# Параллельность пакетной оценки
# CQA_CONCURRENCY=4

# Порт / хост
# CQA_PORT=8000
# CQA_HOST=127.0.0.1
